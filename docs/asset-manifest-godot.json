{
  "version": 2,
  "status": "v0.2 生效规格（像素国风 / Q16 路线 A）",
  "source": ["docs/04-像素国风规格修订.md", "docs/asset-manifest-pixel.json", "docs/07-图标与挂件形状规范.md"],
  "note": "本文件专供 Godot 工程结构自检按当前生效规格核对资源。docs/asset-manifest.json 是 v1 水墨 256px / 105 帧的归档基线，工程停用，不得拿它判定本工程。",
  "budget": {
    "textureMemoryMB": 128
  },
  "rules": [
    {
      "name": "主角序列帧（1 职业 / 15 帧）",
      "glob": "assets/char/char_*.png",
      "naming": "^char_[a-z0-9_]+_(idle|run|cast|hit|death)_r_[0-9]{2}$",
      "minSize": [64, 64],
      "maxSize": [64, 64],
      "powerOfTwo": true,
      "bytesPerPixel": 4,
      "required": true,
      "minCount": 15,
      "maxCount": 30,
      "spec": {
        "facing": "只出朝右一套，scale.x = ±1 镜像",
        "frameTable": "idle 3 / run 4 / cast 4 / hit 1 / death 3",
        "status": "形状样板，待 4x 实机目检与合规确认"
      }
    },
    {
      "name": "怪物序列帧（4 种 / 各 15 帧）",
      "glob": "assets/enemy/mob_*.png",
      "naming": "^mob_[a-z0-9_]+_(idle|run|atk|cast|hit|death)_r_[0-9]{2}$",
      "minSize": [64, 64],
      "maxSize": [64, 64],
      "powerOfTwo": true,
      "bytesPerPixel": 4,
      "required": true,
      "minCount": 60,
      "maxCount": 90,
      "spec": { "status": "B2 已满帧；R22 阴兵深色对比度待实机目检" }
    },
    {
      "name": "流派挂件（4 件）",
      "glob": "assets/char/acc/acc_*.png",
      "naming": "^acc_[a-z0-9_]+$",
      "minSize": [16, 16],
      "maxSize": [16, 16],
      "powerOfTwo": true,
      "bytesPerPixel": 4,
      "required": true,
      "minCount": 4,
      "maxCount": 8
    },
    {
      "name": "技能特效形状样板（16 帧）",
      "glob": "assets/vfx/frames/vfx_*.png",
      "naming": "^vfx_[a-z0-9_]+_[0-9]{2}$",
      "minSize": [64, 64],
      "maxSize": [64, 64],
      "powerOfTwo": true,
      "bytesPerPixel": 4,
      "required": true,
      "minCount": 16,
      "maxCount": 32,
      "spec": {
        "status": "Q24 已定为「程序化为主 + pixelfx 补 overlay/命中」；这 16 帧只是形状样板，不是最终实现",
        "shapeLanguage": "06 §4 的 8 形状语言，避免 R16 撞形"
      }
    },
    {
      "name": "图标（47 件 / 双档 16 与 32）",
      "glob": "assets/ui/icons/icon_*.png",
      "naming": "^icon_[a-z0-9_]+$",
      "minSize": [16, 16],
      "maxSize": [32, 32],
      "powerOfTwo": true,
      "bytesPerPixel": 4,
      "required": true,
      "minCount": 47,
      "maxCount": 60,
      "spec": { "catalog": "docs/icon-catalog.json v0.7", "palette": "24 色锁定板" }
    },
    {
      "name": "卡面资源（4 卡框 + 6 类别纹样）",
      "glob": "assets/ui/cards/*.png",
      "naming": "^(frame|sigil)_[a-z0-9_]+$",
      "minSize": [24, 24],
      "maxSize": [96, 144],
      "bytesPerPixel": 4,
      "required": true,
      "minCount": 10,
      "maxCount": 20,
      "spec": {
        "note": "96x144 卡框与 24x24 纹样不是 2 的幂，故本规则不设 powerOfTwo；卡面 PNG 不含文字（R9 字体授权未核验）",
        "uiSpec": "docs/12-卡牌UI规格.md"
      }
    }
  ]
}
