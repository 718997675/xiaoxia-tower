  "rules": [
    {
      "name": "人物序列帧",
      "glob": "assets/char/**/*.png",
      "naming": "^char_[a-z0-9]+_(idle|run|cast|hit|death)_r_[0-9]{2}$",
      "baselineFrame": [
        64,
        64
      ],
      "maxSize": [
        128,
        128
      ],
      "minSize": [
        32,
        32
      ],
      "powerOfTwo": true,
      "bytesPerPixel": 4,
      "format": "PNG RGBA8 透明底硬边",
      "required": true,
      "minCount": 75,
      "maxCount": 120,
      "actions": {
        "idle": 3,
        "run": 4,
        "cast": 4,
        "hit": 1,
        "death": 3
      },
      "characters": 5,
      "spec": {
        "facing": "只出朝右一套，工程内按 facing 做 scale.x = ±1 镜像",
        "anchor": "脚底锚点全角色统一，落在同一整数像素行",
        "bottomPadding": "角色底部留 ≥1 px 透明边",
        "hitFlash": "闪白与顿帧交给 shader，不占用 hit 动画帧"
      }
    },
    {
      "name": "技能特效-程序化（Q18 推荐案）",
      "glob": "assets/vfx/particles/*.png",
      "naming": "^vfxp_[a-z0-9]+$",
      "required": false,
      "activeByDefault": true,
      "minCount": 2,
      "maxCount": 4,
      "spec": {
        "textures": [
          "16x16 方粒贴图",
          "32x32 光斑"
        ],
        "architecture": "GPUParticles2D + shader 拖尾/闪白，挂独立 VfxLayer，只监听 vfx_requested 信号，不参与命中判定、不阻塞结算",
        "parameterization": "4 流派 × 12 词缀只改颜色/粒子数/拖尾角度即可产生视觉差异，无需补帧",
        "hitboxAlignment": "首帧须与 24x32 判定框 / 身前 16 px 对齐"
      }
    },
    {
      "name": "技能特效-序列帧（Q18 备选案）",
      "glob": "assets/vfx/frames/*.png",
      "naming": "^vfx_[a-z0-9]+_[0-9]{2}$",
      "baselineFrame": [
        64,
        64
      ],
      "maxSize": [
        128,
        128
      ],
      "minSize": [
        32,
        32
      ],
      "powerOfTwo": true,
      "required": false,
      "activeByDefault": false,
      "minCount": 28,
      "maxCount": 36,
      "spec": {
        "composition": "4 技能 × 6 帧 + 命中通用 4 帧",
        "perSkillDistinct": "每个技能一套可辨识效果，满足『每次释放技能要有技能效果』",
        "hitboxAlignment": "24x32 px 判定框，中心在角色身前 16 px × facing；特效首帧需与之对齐"
      }
    },
    {
      "name": "图标",
      "glob": "assets/ui/icons/*.png",
      "naming": "^icon_[a-z0-9_]+$",
      "baselineFrame": [
        16,
        16
      ],
      "maxSize": [
        32,
        32
      ],
      "minSize": [
        16,
        16
      ],
      "powerOfTwo": true,
      "required": false,
      "minCount": 40,
      "maxCount": 60,
      "spec": {
        "scope": "8 技能 / 4 流派 / 12 词缀 / 9 境界 / 装备 / 灵韵",
        "rule": "靠形状区分，不靠新增颜色（24 色板锁定）"
      }
    },
    {
      "name": "UI 图集",
      "glob": "assets/ui/atlas/*.png",
      "naming": "^ui_[a-z0-9_]+$",
      "required": false,
      "spec": {
        "canvasLogical": [
          480,
          270
        ],
        "ninePatch": true,
        "font": "简中像素字体，授权与可用性待查证；不得默认可商用",
        "textLayer": "文字层可单独以 2x(960x540) 渲染保清晰，但描边风格须统一"
      }
    }
